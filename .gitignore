# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

# ── Next.js ───────────────────────────────────────────────────────────────────
/.next/
/out/
/build

# ── Environment (NEVER commit — use .env.example instead) ─────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage
/playwright-report
/test-results
/blob-report

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Prisma ────────────────────────────────────────────────────────────────────
# Do NOT ignore prisma/migrations — they must be committed
# Do NOT ignore prisma/schema.prisma — it is the source of truth

# ── Docker ────────────────────────────────────────────────────────────────────
# docker-compose.yml and docker-compose.prod.yml ARE committed
# Docker volumes are managed by Docker, not git

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.pem

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel
