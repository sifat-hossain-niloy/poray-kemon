# ─────────────────────────────────────────────────────────────────────────────
# Production environment template.
#
# Copy this to `.env.production` ON THE PRODUCTION HOST and fill the values.
# NEVER commit the real .env.production. NEVER copy production secrets onto
# a developer machine — generate fresh ones per environment.
#
# After copying:
#   chmod 600 .env.production
#   chown $DEPLOY_USER:$DEPLOY_USER .env.production
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://poraykemon.com

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=poraykemon
POSTGRES_PASSWORD=replace-me-with-a-long-random-string
POSTGRES_DB=poraykemon
# DATABASE_URL is composed by docker-compose.prod.yml from the three above.

# ── Redis (internal — no auth needed inside the Docker network) ───────────────
REDIS_URL=redis://redis:6379

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=https://poraykemon.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ — Authorized redirect URI must be:
#   https://poraykemon.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin (internal moderation panel) ─────────────────────────────────────────
# Generate with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-me
# Used by `pnpm db:seed` on first deploy to set the initial admin password.
# Change immediately after first login.
ADMIN_SEED_PASSWORD=replace-me-and-change-on-first-login

# ── Umami (optional analytics) ───────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
UMAMI_APP_SECRET=replace-me

# ── Image tag (used by docker-compose.prod.yml when pulling from GHCR) ────────
# In CI deploys, the workflow exports IMAGE_TAG=<git-sha> dynamically; you can
# also set it manually for ad-hoc rollbacks. Defaults to 'latest'.
# IMAGE_TAG=sha-abc123
