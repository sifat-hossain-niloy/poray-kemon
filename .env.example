# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for Poray Kemon.
#
# Two supported target environments:
#   1. Local dev (docker-compose stack)  — use the localhost URLs.
#   2. Vercel + Neon + Upstash           — see docs/deployment/vercel-neon.md.
#
# Never commit .env.local. Only this .env.example (with placeholder values).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (docker-compose) — both URLs point at the same DB:
DATABASE_URL="postgresql://poraykemon:secret@localhost:5434/poraykemon"
DIRECT_URL="postgresql://poraykemon:secret@localhost:5434/poraykemon"
DATABASE_URL_TEST="postgresql://poraykemon:secret@localhost:5435/poraykemon_test"

# Neon (production): DATABASE_URL is the pooled connection (safe for
# serverless request paths); DIRECT_URL is the direct-to-primary connection
# used by Prisma migrations. Both are REQUIRED when the schema declares
# `directUrl` — Prisma no longer falls back to DATABASE_URL for it.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-south-1.aws.neon.tech/poraykemon?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.ap-south-1.aws.neon.tech/poraykemon?sslmode=require"

# ── Redis ─────────────────────────────────────────────────────────────────────
# OPTIONAL. When unset, the app falls back to no-cache (reads hit the DB every
# time; writes still work). Safe to omit for the first Vercel deploy.
# Local dev: redis://localhost:6379
# Upstash Free (recommended): grab the `rediss://` URL from console.upstash.com
REDIS_URL="redis://localhost:6379"
# REDIS_URL="redis://default:********@loving-macaw-120725.upstash.io:6379"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Local: http://localhost:3000
# Production: https://poraykemon.com
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/
# Local dev — Authorized JavaScript origins: http://localhost:3000
# Local dev — Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
# Production — Authorized JavaScript origins: https://poraykemon.com
# Production — Authorized redirect URI:      https://poraykemon.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="your-admin-session-secret-here"
# Optional — used by prisma/seed.ts to bootstrap the first admin user.
# Change the password immediately after first login.
# ADMIN_SEED_PASSWORD="changeme123"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
